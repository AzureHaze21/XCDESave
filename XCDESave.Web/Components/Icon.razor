<svg class="i" width="@Size" height="@Size" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "weapon":
            <path d="M19 3h2v2L11.5 14.5l-2-2zM7.5 11.5l5 5M9.5 14.5l-4 4M3.5 20.5l2-2" />
            break;
        case "head":
            <path d="M4 16a8 8 0 0 1 16 0v3H4zM12 8v5M8 16h8" />
            break;
        case "torso":
            <path d="M8 4L4 7l2 4 2-1v10h8V10l2 1 2-4-4-3c-1 1.5-2.2 2-4 2s-3-.5-4-2z" />
            break;
        case "arms":
            <path d="M7 12V6.5a1.5 1.5 0 0 1 3 0V11M10 11V5a1.5 1.5 0 0 1 3 0v6M13 11V6a1.5 1.5 0 0 1 3 0v6M16 12V9a1.5 1.5 0 0 1 3 0v5a7 7 0 0 1-7 7h-1a6 6 0 0 1-5-3l-2.4-4a1.5 1.5 0 0 1 2.5-1.6L7 14" />
            break;
        case "legs":
            <path d="M7 3h10l-1 18h-3l-1-11-1 11H8z" />
            break;
        case "feet":
            <path d="M6 3h6v9l6.5 3.2A2 2 0 0 1 20 17v3H6zM6 16h6" />
            break;
        case "crystal":
            <path d="M12 2l5 6-5 14-5-14zM7 8h10" />
            break;
        case "gem":
            <path d="M6 3h12l4 6-10 12L2 9zM2 9h20M12 21L8 9l4-6 4 6z" />
            break;
        case "collectable":
            <path d="M5 19c0-8 5-14 15-15-1 10-7 15-15 15zM5 19l8-8" />
            break;
        case "material":
            <path d="M12 2l8.5 5v10L12 22l-8.5-5V7z" />
            <circle cx="12" cy="12" r="3" />
            break;
        case "key":
            <circle cx="8" cy="15" r="4" />
            <path d="M11 12l9-9M16 7l3 3M14 9l2 2" />
            break;
        case "book":
            <path d="M4 4h6a2 2 0 0 1 2 2v14a2 2 0 0 0-2-2H4zM20 4h-6a2 2 0 0 0-2 2v14a2 2 0 0 1 2-2h6z" />
            break;
        case "users":
            <circle cx="9" cy="8" r="3.5" />
            <path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 6" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" />
            <path d="M4.5 21a7.5 7.5 0 0 1 15 0" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" />
            <path d="M20 20l-4-4" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "minus":
            <path d="M5 12h14" />
            break;
        case "star":
            <path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1 6.2-5.5-2.9-5.5 2.9 1-6.2L3 9.6l6.2-.9z" />
            break;
        case "lock":
            <rect x="5" y="11" width="14" height="9" rx="2" />
            <path d="M8 11V8a4 4 0 0 1 8 0v3" />
            break;
        case "download":
            <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
            break;
        case "upload":
            <path d="M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4M12 15V4M7 9l5-5 5 5" />
            break;
        case "file":
            <path d="M14 3H6v18h12V7zM14 3v4h4" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 8h.01" />
            break;
        case "shield":
            <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4" />
            break;
        case "roundtrip":
            <path d="M20 11a8 8 0 0 0-14-4.5L4 9M4 4v5h5M4 13a8 8 0 0 0 14 4.5L20 15M20 20v-5h-5" />
            break;
        case "save":
            <rect x="4" y="4" width="16" height="16" rx="2" />
            <path d="M8 4v5h8V4M8 20v-6h8v6" />
            break;
        case "layers":
            <path d="M12 3l9 5-9 5-9-5zM3 13l9 5 9-5" />
            break;
        case "logo":
            <circle cx="12" cy="12" r="9" />
            <circle cx="12" cy="12" r="3.5" />
            <path d="M12 3v4.5M12 16.5V21M3 12h4.5M16.5 12H21" />
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; }
    [Parameter] public int Size { get; set; } = 20;

    // shortcut: line icons per item type stand in for real item thumbnails; swap in images once we have them.
    public static string For(ItemType type) => type switch
    {
        ItemType.Weapon => "weapon",
        ItemType.HeadArmour => "head",
        ItemType.TorsoArmour => "torso",
        ItemType.ArmArmour => "arms",
        ItemType.LegArmour => "legs",
        ItemType.FootArmour => "feet",
        ItemType.Crystal => "crystal",
        ItemType.Gem => "gem",
        ItemType.Collectable => "collectable",
        ItemType.Material => "material",
        ItemType.KeyItem => "key",
        ItemType.ArtsManual => "book",
        _ => "file"
    };
}
