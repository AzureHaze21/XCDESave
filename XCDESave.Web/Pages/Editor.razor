@page "/"
@using System.Globalization
@inject IJSRuntime JS

<PageTitle>XCDE Save Editor</PageTitle>

@if (save == null)
{
    <div class="app">
        <header class="topbar">@Brand</header>
        <main class="open">
            <div class="open-head">
                <span class="eyebrow">Xenoblade Chronicles: Definitive Edition</span>
                <h1 class="display">Open your save</h1>
                <p class="lede">Edit inventory, gear, gem effects and party progress, then download a new copy of the file.</p>
            </div>
            @Banners
            <label class="dropzone">
                <span class="dropzone-icon"><Icon Name="upload" Size="34" /></span>
                <span class="dropzone-title">Drop a save file here</span>
                <span class="muted">A <code>bfsgame0xx.sav</code> file, exactly @XCDESaveData.SIZE.ToString("N0") bytes</span>
                <span class="btn primary"><Icon Name="file" Size="18" />Choose a file</span>
                <InputFile OnChange="Open" accept=".sav" class="dropzone-input" />
            </label>
            <ul class="facts">
                <li class="fact">
                    <Icon Name="shield" Size="22" />
                    <h2>Stays on this device</h2>
                    <p>The file is read and edited in your browser. It is never uploaded.</p>
                </li>
                <li class="fact">
                    <Icon Name="roundtrip" Size="22" />
                    <h2>Round-trip checked</h2>
                    <p>A save that can't be written back byte for byte is refused, so it can't be corrupted.</p>
                </li>
                <li class="fact">
                    <Icon Name="save" Size="22" />
                    <h2>Keep a backup</h2>
                    <p>Downloading writes a new copy. Hold on to the original until the edit loads in game.</p>
                </li>
            </ul>
            <p class="muted center small">Thumbnails (.tmb) and the settings file (bfssystem.sav) aren't edited.</p>
        </main>
    </div>
}
else
{
    <div class="app">
        <header class="topbar">
            @Brand
            <div class="file-chip">
                <Icon Name="file" Size="18" />
                <span class="file-name">@fileName</span>
                <span class="file-meta">Saved @SavedOn</span>
                <span class="verified"><span class="dot" aria-hidden="true"></span>Round-trip verified</span>
            </div>
            <div class="spacer"></div>
            <dl class="funds">
                <div><dt>Play time</dt><dd>@PlayTimeText</dd></div>
                <div><dt>Money</dt><dd>@save.Money.ToString("N0") G</dd></div>
                <div><dt>Noponstones</dt><dd>@save.Noponstones.ToString("N0")</dd></div>
            </dl>
            <div class="actions">
                <label class="btn">
                    <Icon Name="upload" Size="18" />Open
                    <InputFile OnChange="Open" accept=".sav" class="sr" />
                </label>
                <button type="button" class="btn primary" @onclick="Download"><Icon Name="download" Size="18" />Download edited save</button>
            </div>
        </header>
        @Banners
        <div class="shell">
            <nav class="rail" aria-label="Save sections">
                <div class="rail-group">
                    <span class="rail-heading">Party</span>
                    <button type="button" class="rail-link @(tab == null ? "active" : "")" aria-current="@(tab == null ? "page" : null)" @onclick="() => SelectTab(null)">
                        <Icon Name="users" /><span class="rail-label">Characters</span><span class="count">@save.PartyMembers.Length</span>
                    </button>
                </div>
                @foreach (var group in BOXES.GroupBy(b => b.Group))
                {
                    <div class="rail-group">
                        <span class="rail-heading">@group.Key</span>
                        @foreach (var box in group)
                        {
                            <button type="button" class="rail-link @(tab == box ? "active" : "")" aria-current="@(tab == box ? "page" : null)" @onclick="() => SelectTab(box)">
                                <Icon Name="@Icon.For(box.Type)" /><span class="rail-label">@box.Label</span><span class="count">@box.Get(save).Count(i => i.Exists)</span>
                            </button>
                        }
                    </div>
                }
            </nav>
            <main class="content">
                @if (tab == null)
                {
                    @PartyView()
                }
                else
                {
                    @InventoryView(tab)
                }
            </main>
        </div>
    </div>
}

@code {
    record BoxTab(string Label, string Singular, string Group, ItemType Type, Func<XCDESaveData, Item[]> Get, (int From, int To)[] Fill = null);
    record GearSlot(string Label, ItemType Type, Func<PartyMember, ItemID> Get, Action<PartyMember, ItemID> Set);

    const int EMPTY_PREVIEW = 8;

    static readonly BoxTab[] BOXES =
    {
        new("Weapons", "Weapon", "Equipment", ItemType.Weapon, s => s.Weapons),
        new("Head", "Head armour", "Equipment", ItemType.HeadArmour, s => s.HeadArmour),
        new("Torso", "Torso armour", "Equipment", ItemType.TorsoArmour, s => s.TorsoArmour),
        new("Arms", "Arm armour", "Equipment", ItemType.ArmArmour, s => s.ArmArmour),
        new("Legs", "Leg armour", "Equipment", ItemType.LegArmour, s => s.LegArmour),
        new("Feet", "Foot armour", "Equipment", ItemType.FootArmour, s => s.FootArmour),
        new("Crystals", "Crystal", "Gems & crystals", ItemType.Crystal, s => s.Crystals),
        new("Gems", "Gem", "Gems & crystals", ItemType.Gem, s => s.Gems),
        new("Collectables", "Collectable", "Items", ItemType.Collectable, s => s.Collectables, ItemFiller.COLLECTABLES),
        new("Materials", "Material", "Items", ItemType.Material, s => s.Materials, ItemFiller.MATERIALS),
        new("Key items", "Key item", "Items", ItemType.KeyItem, s => s.KeyItems),
        new("Arts manuals", "Arts manual", "Items", ItemType.ArtsManual, s => s.ArtsManuals, ItemFiller.ARTS_MANUALS),
    };

    // A party member's *Equip fields hold a SLOT in the matching inventory box, not an item ID.
    static readonly GearSlot[] GEAR =
    {
        new("Weapon", ItemType.Weapon, m => m.WeaponEquip, (m, v) => m.WeaponEquip = v),
        new("Head", ItemType.HeadArmour, m => m.HeadEquip, (m, v) => m.HeadEquip = v),
        new("Torso", ItemType.TorsoArmour, m => m.TorsoEquip, (m, v) => m.TorsoEquip = v),
        new("Arms", ItemType.ArmArmour, m => m.ArmEquip, (m, v) => m.ArmEquip = v),
        new("Legs", ItemType.LegArmour, m => m.LegEquip, (m, v) => m.LegEquip = v),
        new("Feet", ItemType.FootArmour, m => m.FootEquip, (m, v) => m.FootEquip = v),
    };

    XCDESaveData save;
    string fileName, error, status;
    BoxTab tab;          // null = Characters
    int? slot;
    int member;
    string filter = "";
    bool showEmpty = true;
    int openSocket;      // gem socket whose picker is open, 0 = none
    bool replacing;

    async Task Open(InputFileChangeEventArgs e)
    {
        error = status = null;
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(XCDESaveData.SIZE).CopyToAsync(ms);
            byte[] data = ms.ToArray();
            XCDESaveData loaded = XCDESaveSerialization.Deserialize(data);
            // The library must write this file back unchanged, otherwise downloading would silently corrupt it.
            if (!XCDESaveSerialization.Serialize(loaded).SequenceEqual(data))
                throw new InvalidDataException("This save does not survive a load/save round-trip through XCDESave unchanged, so editing it is not safe.");
            save = loaded;
            fileName = e.File.Name;
            member = 0;
            SelectTab(null);
            status = $"Loaded {fileName}.";
        }
        catch (Exception ex)
        {
            error = "Could not open save: " + ex.Message;
        }
    }

    async Task Download()
    {
        error = status = null;
        byte[] data = XCDESaveSerialization.Serialize(save);
        if (data.Length != XCDESaveData.SIZE)
        {
            error = $"Save data is 0x{data.Length:X} bytes, expected 0x{XCDESaveData.SIZE:X}. Nothing was downloaded.";
            return;
        }
        await JS.InvokeVoidAsync("downloadFile", fileName, data);
    }

    void SelectTab(BoxTab box)
    {
        tab = box;
        filter = "";
        status = null;
        int first = box == null ? -1 : Array.FindIndex(box.Get(save), i => i.Exists);
        SelectSlot(box == null ? null : Math.Max(first, 0));
    }

    void SelectSlot(int? s)
    {
        slot = s;
        openSocket = 0;
        replacing = false;
    }

    void Fill(BoxTab box)
    {
        var (added, noRoom) = ItemFiller.Fill(box.Get(save), box.Type, box.Fill);
        status = $"Added {added} new {box.Label.ToLower()}; every stack is now at least x{ItemFiller.MAX_QUANTITY}."
            + (noRoom > 0 ? $" {noRoom} did not fit: the box is full." : "");
    }

    Item[] BoxOf(ItemType type) => BOXES.First(b => b.Type == type).Get(save);

    static string CharacterName(int memberIndex) => ((Character)(memberIndex + 1)).ToString().Replace('_', ' ');

    bool InParty(int memberIndex) => save.Party.Characters.Take(save.Party.PartyMembersCount).Contains((Character)(memberIndex + 1));

    // slot -> names of the characters whose gear points at it
    Dictionary<int, List<string>> EquipMap(ItemType type)
    {
        var map = new Dictionary<int, List<string>>();
        for (int i = 0; i < save.PartyMembers.Length; i++)
            foreach (var g in GEAR.Where(g => g.Type == type))
            {
                ItemID id = g.Get(save.PartyMembers[i]);
                if (id.TypeID != type) continue;
                if (!map.TryGetValue(id.ID, out var names)) map[id.ID] = names = new List<string>();
                names.Add(CharacterName(i));
            }
        return map;
    }

    IEnumerable<int> VisibleSlots(Item[] items)
    {
        int empties = 0;
        for (int s = 0; s < items.Length; s++)
        {
            if (items[s].Exists)
            {
                if (filter.Length == 0 || ItemNames.Name(items[s].FullID.ID).Contains(filter, StringComparison.OrdinalIgnoreCase)) yield return s;
            }
            else if ((showEmpty && filter.Length == 0 && empties++ < EMPTY_PREVIEW) || s == slot)
            {
                yield return s;
            }
        }
    }

    string SavedOn => save.SaveTime.ToDateTime()?.ToString("ddd d MMM yyyy, HH:mm") ?? "on an unknown date";

    string PlayTimeText => $"{save.PlayTimeSeconds / 3600}:{save.PlayTimeSeconds / 60 % 60:00}:{save.PlayTimeSeconds % 60:00}";

    void SetPlayTime(long? hours, long? minutes, long? seconds)
    {
        uint t = save.PlayTimeSeconds;
        save.PlayTimeSeconds = (uint)((hours ?? t / 3600) * 3600 + (minutes ?? t / 60 % 60) * 60 + (seconds ?? t % 60));
    }

    static string SlotLabel(int s) => "Slot " + s.ToString("00");
    static string GemSlotsText(int n) => n == 0 ? "No gem slots" : n == 1 ? "1 gem slot" : $"{n} gem slots";
    static string Article(string word) => "aeiou".Contains(char.ToLower(word[0])) ? "an" : "a";
    static string Who(List<string> names) => names.Count == 1 ? names[0] : $"{names[0]} +{names.Count - 1}";

    static string Meta(Item item) => $"x{item.Quantity}" + item switch
    {
        EquipItem e => " · " + GemSlotsText(e.GemSlots),
        CrystalItem c => $" · Rank {c.Rank}",
        _ => ""
    };

    static ItemID GemAlt(EquipItem e, int n) => n switch { 1 => e.Gem1Alt, 2 => e.Gem2Alt, _ => e.Gem3Alt };

    static void SetGemAlt(EquipItem e, int n, ItemID v)
    {
        if (n == 1) e.Gem1Alt = v;
        else if (n == 2) e.Gem2Alt = v;
        else e.Gem3Alt = v;
    }

    static ItemID GemEffect(ushort id) => id == 0 ? new ItemID() : new ItemID { ID = id, TypeID = ItemNames.GEM_EFFECT };

    RenderFragment Brand => @<div class="brand">
        <span class="brand-mark"><Icon Name="logo" Size="32" /></span>
        <span class="brand-text"><span class="brand-name">XCDE</span><span class="brand-sub">Save editor</span></span>
    </div>;

    RenderFragment Banners => @<div class="banners">
        @if (error != null) { <div class="banner error" role="alert">@error</div> }
        @if (status != null) { <div class="banner ok" role="status">@status</div> }
    </div>;

    RenderFragment InventoryView(BoxTab box)
    {
        Item[] items = box.Get(save);
        int used = items.Count(i => i.Exists);
        var equipped = EquipMap(box.Type);
        var visible = VisibleSlots(items).ToList();
        int hiddenEmpty = items.Length - used - visible.Count(s => !items[s].Exists);
        string note = filter.Length > 0 ? $"{visible.Count(s => items[s].Exists)} matching {box.Label.ToLower()}."
            : showEmpty ? (hiddenEmpty > 0 ? $"{hiddenEmpty} more empty slots not shown." : "")
            : $"{hiddenEmpty} empty slots hidden.";
        string fillWidth = (used * 100.0 / items.Length).ToString("0.##", CultureInfo.InvariantCulture);

        return @<div class="workspace">
            <section class="box" aria-labelledby="box-title">
                <div class="box-head">
                    <div class="titles">
                        <span class="eyebrow">@box.Group</span>
                        <h1 id="box-title" class="display">@box.Label</h1>
                    </div>
                    <div class="box-tools">
                        <label class="search">
                            <span class="sr">Filter @box.Label.ToLower() by name</span>
                            <Icon Name="search" Size="18" />
                            <input type="search" placeholder="Filter by name" @bind="filter" @bind:event="oninput" />
                        </label>
                        <label class="check"><input type="checkbox" @bind="showEmpty" />Show empty slots</label>
                        @if (box.Fill != null)
                        {
                            <button type="button" class="btn" @onclick="() => Fill(box)"><Icon Name="layers" Size="18" />Add all @box.Label.ToLower()</button>
                        }
                    </div>
                </div>
                <div class="capacity">
                    <div class="bar" aria-hidden="true"><div style="width: @(fillWidth)%"></div></div>
                    <span>@used of @items.Length slots used</span>
                </div>
                <div class="slots">
                    @foreach (int s in visible)
                    {
                        int at = s;
                        Item item = items[at];
                        bool selected = slot == at;
                        if (item.Exists)
                        {
                            <button type="button" class="slot @(selected ? "selected" : "")" aria-pressed="@(selected ? "true" : "false")" @onclick="() => SelectSlot(at)">
                                <span class="slot-top">
                                    <span class="slot-num">@SlotLabel(at)</span>
                                    @if (equipped.TryGetValue(at, out var names))
                                    {
                                        <span class="chip accent">@Who(names)</span>
                                    }
                                </span>
                                <span class="thumb"><Icon Name="@Icon.For(box.Type)" Size="28" /></span>
                                <span class="slot-name">@ItemNames.Name(item.FullID.ID)</span>
                                <span class="slot-meta">@Meta(item)</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="slot empty @(selected ? "selected" : "")" aria-pressed="@(selected ? "true" : "false")" @onclick="() => SelectSlot(at)">
                                <Icon Name="plus" Size="22" />
                                <span>Empty slot</span>
                                <span class="slot-num">@SlotLabel(at)</span>
                            </button>
                        }
                    }
                </div>
                @if (note.Length > 0)
                {
                    <p class="muted small">@note</p>
                }
            </section>
            <aside class="inspector" aria-label="Selected slot">
                @if (slot is int sel && sel < items.Length)
                {
                    @SlotPanel(box, items, sel, equipped)
                }
                else
                {
                    <p class="muted">Pick a slot to edit it.</p>
                }
            </aside>
        </div>;
    }

    RenderFragment SlotPanel(BoxTab box, Item[] items, int s, Dictionary<int, List<string>> equipped)
    {
        Item item = items[s];
        if (!item.Exists)
        {
            if (box.Type == ItemType.Crystal || box.Type == ItemType.Gem)
                return @<div class="stack">
                    <div class="item-titles">
                        <span class="eyebrow muted">Empty · @SlotLabel(s)</span>
                        <h2 class="display-sm">Empty slot</h2>
                    </div>
                    <p class="muted">Crystals and gems are generated by the game with random effects, so adding them here isn't supported.</p>
                </div>;

            ushort quantity = box.Type == ItemType.KeyItem || item is EquipItem ? (ushort)1 : ItemFiller.MAX_QUANTITY;
            return @<div class="stack">
                <div class="item-titles">
                    <span class="eyebrow muted">Empty · @SlotLabel(s)</span>
                    <h2 class="display-sm">Add @Article(box.Singular) @box.Singular.ToLower()</h2>
                    <p class="muted">Pick one; the slot index, serial number and type are filled in for you.</p>
                </div>
                <ItemPicker Type="box.Type" Label="@box.Label.ToLower()" OnPick="@(id => ItemFiller.Put(items, s, id, box.Type, quantity))" />
            </div>;
        }

        equipped.TryGetValue(s, out var users);
        return @<div class="stack-lg">
            <div class="item-head">
                <span class="thumb lg"><Icon Name="@Icon.For(box.Type)" Size="42" /></span>
                <div class="item-titles">
                    <span class="eyebrow muted">@box.Singular · @SlotLabel(s)</span>
                    <h2 class="display-sm">@ItemNames.Name(item.FullID.ID)</h2>
                    <span class="muted small">Item #@item.FullID.ID · Serial @item.SerialNo</span>
                </div>
            </div>

            @if (users != null)
            {
                <div class="equipped-banner"><Icon Name="user" Size="18" /><span>Equipped by <strong>@string.Join(", ", users)</strong></span></div>
            }

            <section class="group">
                <h3 class="section-title">Stack</h3>
                <div class="row">
                    <NumberField Label="Quantity" Value="item.Quantity" Min="1" Max="ItemFiller.MAX_QUANTITY" Stepper="true" ValueChanged="@((long v) => item.Quantity = (ushort)v)" />
                    <button type="button" class="btn toggle @(item.Favourite ? "on" : "")" aria-pressed="@(item.Favourite ? "true" : "false")" @onclick="() => item.Favourite = !item.Favourite">
                        <Icon Name="star" Size="18" />Favourite
                    </button>
                </div>
            </section>

            @if (item is EquipItem equip)
            {
                <section class="group">
                    <h3 class="section-title">Equipment</h3>
                    <div class="row">
                        <NumberField Label="Weight" Value="equip.Weight" Max="byte.MaxValue" ValueChanged="@((long v) => equip.Weight = (byte)v)" />
                        <fieldset class="segmented-field">
                            <legend>Gem slots</legend>
                            <div class="segmented">
                                @for (byte n = 0; n <= 3; n++)
                                {
                                    byte count = n;
                                    <button type="button" class="@(equip.GemSlots == count ? "on" : "")" aria-pressed="@(equip.GemSlots == count ? "true" : "false")" @onclick="() => equip.GemSlots = count">@count</button>
                                }
                            </div>
                        </fieldset>
                    </div>
                </section>

                <section class="group">
                    <h3 class="section-title">Gem effects</h3>
                    @for (int n = 1; n <= 3; n++)
                    {
                        int socket = n;
                        ItemID effect = GemAlt(equip, socket);
                        if (socket <= equip.GemSlots)
                        {
                            <div class="socket">
                                <Icon Name="gem" Size="20" />
                                <span class="socket-text">
                                    <span class="socket-label">Socket @socket</span>
                                    @if (effect.ID == 0)
                                    {
                                        <span class="strong">Empty</span>
                                    }
                                    else
                                    {
                                        <span class="gem-chip"><Icon Name="gem" Size="14" />@ItemNames.Name(effect.ID) <span class="pick-id">#@effect.ID</span></span>
                                    }
                                </span>
                                @if (effect.ID != 0)
                                {
                                    <button type="button" class="btn ghost small" @onclick="() => SetGemAlt(equip, socket, GemEffect(0))">Clear</button>
                                }
                                <button type="button" class="btn outline small" aria-expanded="@(openSocket == socket ? "true" : "false")" @onclick="() => openSocket = openSocket == socket ? 0 : socket">@(effect.ID == 0 ? "Add gem effect" : "Change")</button>
                            </div>
                            @if (openSocket == socket)
                            {
                                <ItemPicker Type="ItemType.Gem" Label="gem effects" OnPick="@(id => { SetGemAlt(equip, socket, GemEffect(id)); openSocket = 0; })" />
                            }
                        }
                        else
                        {
                            <div class="socket locked">
                                <Icon Name="lock" Size="20" />
                                <span class="socket-text">
                                    <span class="socket-label">Socket @socket</span>
                                    <span>Needs @GemSlotsText(socket).ToLower()@(effect.ID != 0 ? $" · holds {ItemNames.Name(effect.ID)}" : "")</span>
                                </span>
                            </div>
                        }
                    }
                </section>
            }
            else if (item is CrystalItem crystal)
            {
                <section class="group">
                    <h3 class="section-title">Crystal</h3>
                    <p class="muted">Rank @crystal.Rank · element @crystal.Element · @crystal.BuffCount effect(s)@(crystal.IsCylinder ? " · cylinder" : "")</p>
                </section>
            }

            <div class="actions-row">
                <button type="button" class="btn" aria-expanded="@(replacing ? "true" : "false")" @onclick="() => replacing = !replacing">Replace with another @box.Singular.ToLower()</button>
                @if (users == null)
                {
                    <button type="button" class="btn danger" @onclick="() => item.Exists = false">Remove from inventory</button>
                }
                else
                {
                    <button type="button" class="btn" disabled aria-describedby="remove-note">Remove from inventory</button>
                    <p id="remove-note" class="muted small full">Unequip it from @string.Join(", ", users) first, so their gear doesn't point at an empty slot.</p>
                }
            </div>
            @if (replacing)
            {
                <ItemPicker Type="box.Type" Label="@box.Label.ToLower()" OnPick="@(id => { item.FullID = new ItemID { ID = id, TypeID = box.Type }; replacing = false; })" />
            }
        </div>;
    }

    RenderFragment PartyView() => @<div class="workspace">
        <section class="roster-col" aria-labelledby="party-title">
            <div class="titles">
                <span class="eyebrow">Party</span>
                <h1 id="party-title" class="display">Characters</h1>
                <span class="muted">@save.PartyMembers.Length characters · @save.Party.PartyMembersCount in the active party</span>
            </div>
            <div class="roster">
                @for (int i = 0; i < save.PartyMembers.Length; i++)
                {
                    int index = i;
                    string name = CharacterName(index);
                    <button type="button" class="member @(member == index ? "selected" : "")" aria-pressed="@(member == index ? "true" : "false")" @onclick="() => member = index">
                        <span class="monogram" aria-hidden="true">@name[0]</span>
                        <span class="member-text">
                            <span class="member-name">@name</span>
                            <span class="muted small">Lv @save.PartyMembers[index].Level</span>
                        </span>
                        @if (InParty(index))
                        {
                            <span class="party-dot" title="In active party"></span><span class="sr">In active party</span>
                        }
                    </button>
                }
            </div>
            <p class="legend muted small"><span class="party-dot static" aria-hidden="true"></span>In the active party</p>
            <section class="card" aria-labelledby="file-title">
                <h2 id="file-title" class="section-title">Save file</h2>
                <p class="muted small">Saved @SavedOn</p>
                <fieldset class="playtime">
                    <legend>Play time</legend>
                    <div class="row">
                        <NumberField Label="Hours" Value="save.PlayTimeSeconds / 3600" Max="uint.MaxValue / 3600 - 1" ValueChanged="@((long v) => SetPlayTime(v, null, null))" />
                        <NumberField Label="Minutes" Value="save.PlayTimeSeconds / 60 % 60" Max="59" ValueChanged="@((long v) => SetPlayTime(null, v, null))" />
                        <NumberField Label="Seconds" Value="save.PlayTimeSeconds % 60" Max="59" ValueChanged="@((long v) => SetPlayTime(null, null, v))" />
                    </div>
                </fieldset>
                <div class="row">
                    <NumberField Label="Money" Value="save.Money" Max="uint.MaxValue" ValueChanged="@((long v) => save.Money = (uint)v)" />
                    <NumberField Label="Noponstones" Value="save.Noponstones" Max="uint.MaxValue" ValueChanged="@((long v) => save.Noponstones = (uint)v)" />
                </div>
            </section>
        </section>
        <section class="sheet" aria-labelledby="sheet-title">
            @Sheet(save.PartyMembers[member])
        </section>
    </div>;

    RenderFragment Sheet(PartyMember m)
    {
        string name = CharacterName(member);
        return @<div class="stack-lg">
            <div class="sheet-head">
                <span class="monogram xl" aria-hidden="true">@name[0]</span>
                <div class="sheet-titles">
                    <h2 id="sheet-title" class="display">@name</h2>
                    <div class="chips">
                        <span class="chip teal">Level @m.Level</span>
                        @if (InParty(member))
                        {
                            <span class="chip accent">In active party</span>
                        }
                    </div>
                </div>
            </div>

            <div class="note">
                <Icon Name="info" Size="20" />
                <p>HP, Strength and the other battle stats aren't stored in the save. The game works them out from level, gear and gems, so change those instead.</p>
            </div>

            <section class="group">
                <h3 class="section-title">Progress</h3>
                <div class="fields">
                    <NumberField Label="Level" Hint="(max 99)" Value="m.Level" Min="1" Max="99" Stepper="true" ValueChanged="@((long v) => m.Level = (uint)v)" />
                    <NumberField Label="EXP" Value="m.EXP" Max="uint.MaxValue" ValueChanged="@((long v) => m.EXP = (uint)v)" />
                    <NumberField Label="AP" Value="m.AP" Max="uint.MaxValue" ValueChanged="@((long v) => m.AP = (uint)v)" />
                    <NumberField Label="Affinity coins" Value="m.AffinityCoins" Max="uint.MaxValue" ValueChanged="@((long v) => m.AffinityCoins = (uint)v)" />
                </div>
            </section>

            <section class="group">
                <h3 class="section-title">Expert mode</h3>
                <div class="fields">
                    <NumberField Label="Expert level" Hint="(max 99)" Value="m.ExpertModeLevel" Max="99" ValueChanged="@((long v) => m.ExpertModeLevel = (uint)v)" />
                    <NumberField Label="Expert EXP" Value="m.ExpertModeEXP" Max="uint.MaxValue" ValueChanged="@((long v) => m.ExpertModeEXP = (uint)v)" />
                    <NumberField Label="Reserve EXP" Value="m.ExpertModeReserveEXP" Max="uint.MaxValue" ValueChanged="@((long v) => m.ExpertModeReserveEXP = (uint)v)" />
                </div>
            </section>

            <section class="group">
                <div class="section-head">
                    <h3 class="section-title">Gear</h3>
                    <span class="muted small">Choose from what's in your inventory. The game normally limits each weapon type to one character.</span>
                </div>
                @foreach (var g in GEAR)
                {
                    Item[] box = BoxOf(g.Type);
                    ItemID current = g.Get(m);
                    Item worn = current.ID < box.Length ? box[current.ID] : null;
                    bool has = worn != null && worn.Exists;
                    var gems = has && worn is EquipItem wornEquip
                        ? Enumerable.Range(1, 3).Select(n => GemAlt(wornEquip, n)).Where(x => x.ID != 0).Select(x => ItemNames.Name(x.ID)).ToList()
                        : new List<string>();
                    <div class="gear-row">
                        <span class="thumb md"><Icon Name="@Icon.For(g.Type)" Size="24" /></span>
                        <span class="gear-text">
                            <span class="eyebrow muted">@g.Label</span>
                            <span class="strong">@(has ? ItemNames.Name(worn.FullID.ID) : $"Empty slot {current.ID}")</span>
                        </span>
                        <span class="gear-gems">
                            @if (gems.Any())
                            {
                                @foreach (var gem in gems)
                                {
                                    <span class="gem-chip"><Icon Name="gem" Size="14" />@gem</span>
                                }
                            }
                            else
                            {
                                <span class="muted small">No gem effects</span>
                            }
                        </span>
                        <label class="gear-select">
                            <span class="sr">@g.Label for @name</span>
                            <select value="@current.ID" @onchange="e => g.Set(m, new ItemID { ID = ushort.Parse((string)e.Value), TypeID = g.Type })">
                                @if (!has)
                                {
                                    <option value="@current.ID">Slot @current.ID (empty)</option>
                                }
                                @for (int i = 0; i < box.Length; i++)
                                {
                                    if (box[i].Exists)
                                    {
                                        <option value="@i">@ItemNames.Name(box[i].FullID.ID) · slot @i</option>
                                    }
                                }
                            </select>
                        </label>
                    </div>
                }
            </section>
        </div>;
    }
}
